# =====================================================================
# EmpireBlox Treasury — environment
# Copy to `.env` for local dev. In production, inject these from your
# host's secret manager / KMS, NEVER commit real values.
# =====================================================================

# --- Core ---
PORT=8787
NODE_ENV=development

# Postgres for the treasury ledger. This MUST be a separate database from
# your Supabase game DB. The backend connects with a privileged role; the
# browser never touches this database.
DATABASE_URL=postgres://user:pass@localhost:5432/empireblox_treasury

# --- The master key (KEK) that encrypts every secret in the vault ---
# 32 random bytes, base64. Generate with:  npm run keygen
# This is the ONE secret that must never touch the database or the repo.
# In production, load it from AWS KMS / GCP KMS / Vault, not a plain env var.
TREASURY_MASTER_KEY=

# --- CORS: your live site origin(s), comma separated ---
ALLOW_ORIGIN=http://localhost:3000,https://empireblox.vercel.app

# Set true behind the production HTTPS listener.
COOKIE_SECURE=false

# --- Confirmation safety margin: never scan closer than this to chain head ---
# (reorg buffer; per-chain required confirmations live in the DB)
REORG_SAFETY_BLOCKS=3
